# --- Secrets — never commit these --------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python

# --- Django ------------------------------------------------------------
*.log
db.sqlite3
media/
staticfiles/
/static/vendor/*.map

# --- Uploaded documents (real records must never reach GitHub) ---------
# MEDIA_ROOT already resolves to media/ (see line above), which covers every
# uploaded file. Do NOT add a bare "documents/" pattern here — it silently
# matches apps/documents/ too (git treats unanchored names as "any depth"),
# which once deleted the entire Documents app from every commit.
uploads/
training_data*.jsonl

# --- Testing / tooling -------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Editors and OS ----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
