# ---------------------------------------------------------------------------
# UDM DocTrack — environment settings
#
# Copy this file to ".env" and edit the values. NEVER commit the real .env.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
# ---------------------------------------------------------------------------

# --- Basics ----------------------------------------------------------------
# Generate a new key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-before-you-deploy-anything
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Asia/Manila

# --- Database --------------------------------------------------------------
# Either set DATABASE_URL...
# DATABASE_URL=postgres://udm:udmpass@localhost:5432/udm_doctrack
# ...or the four values below.
POSTGRES_DB=udm_doctrack
POSTGRES_USER=udm
POSTGRES_PASSWORD=udmpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- File storage ----------------------------------------------------------
# local | s3 | azure
# "local" writes to the media/ folder — fine for development and the demo.
STORAGE_BACKEND=local

# Cloudflare R2 (S3-compatible). Fill these only when STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=udm-doctrack
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Azure Blob Storage. Fill these only when STORAGE_BACKEND=azure
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=documents

# --- Text extraction / OCR -------------------------------------------------
# auto = use the text layer first, call OCR only for scanned pages.
OCR_BACKEND=auto
# Free key from https://ocr.space/ocrapi (register, no card needed).
OCR_SPACE_API_KEY=
# Optional paid fallback with better accuracy on Filipino forms.
# AZURE_DOCINT_ENDPOINT=
# AZURE_DOCINT_KEY=

# --- Metadata suggestions --------------------------------------------------
# rules = the built-in rules engine.  ai = the future model.  none = off.
SUGGESTION_ENGINE=rules

# --- Search tuning (only change these if you have read docs/SEARCH_DESIGN.md)
SEARCH_MIN_RELEVANCE_DEFAULT=75
SEARCH_ENABLE_TRIGRAM=True

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
SIGNED_URL_TTL_SECONDS=900

# --- Cache -----------------------------------------------------------------
# Left unset, the cache is a table in PostgreSQL: shared by every Gunicorn
# worker and untouched by restarts, with no extra service to run. "manage.py
# migrate" creates the table. Point REDIS_URL at a Redis instance to use that
# instead (faster; Django ships the backend, nothing else to install).
# REDIS_URL=redis://localhost:6379/0
CACHE_TIMEOUT_SECONDS=300
CACHE_MAX_ENTRIES=20000

# --- Sign-in lockouts ------------------------------------------------------
# Failed attempts allowed before the account (and that IP) is locked.
AXES_FAILURE_LIMIT=5
# How long the FIRST lockout lasts. Each later lockout doubles it...
AXES_COOLOFF_MINUTES=15
# ...up to this ceiling.
AXES_COOLOFF_MAX_MINUTES=1440
# Days without a lockout before the escalation is forgiven and the wait
# starts over from AXES_COOLOFF_MINUTES.
AXES_ESCALATION_DECAY_DAYS=7
# True = a completed sign-in (including any forced password change) also
# forgives the escalation. False = the wait keeps growing until the decay
# window above passes, or until "python manage.py fix_login" is run.
AXES_ESCALATION_RESET_ON_LOGIN=False

# --- Idle sign-out ---------------------------------------------------------
# Minutes of INACTIVITY before a signed-in account is signed out. The clock
# restarts on every request and on activity at the keyboard, so this is idle
# time, not total time signed in — nobody is thrown out mid-task.
# Shared office workstations are the reason this is short: confirming receipt
# writes a permanent entry naming who took custody.
SESSION_IDLE_MINUTES=30
# Seconds of warning before it happens, so unsaved work can be saved.
SESSION_WARNING_SECONDS=120
# True = also sign out when the browser is closed. Worth turning on for
# workstations shared by several staff.
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- Email (optional; leave blank to print emails to the console) ----------
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
